# --- Riot API ----------------------------------------------------------
# Issue your key at https://developer.riotgames.com.
# Dev keys expire every 24h; Personal/Production keys last 1 year.
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# --- Postgres ----------------------------------------------------------
# Used by Drizzle and the worker. Match values to docker-compose.yml.
POSTGRES_USER=loltracker
POSTGRES_PASSWORD=loltracker_dev
POSTGRES_DB=loltracker
POSTGRES_PORT=5432
DATABASE_URL=postgres://loltracker:loltracker_dev@localhost:5432/loltracker

# --- Redis -------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Worker tuning -----------------------------------------------------
# Concurrency per BullMQ worker. Stay well below Riot's 50 req/sec.
WORKER_MATCH_ID_CONCURRENCY=4
WORKER_MATCH_DETAIL_CONCURRENCY=8

# Default region/bracket for seed data
SEED_REGION=kr
SEED_BRACKET=diamond+

# --- pgAdmin (optional, profile with-admin) ----------------------------
PGADMIN_EMAIL=admin@local
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# --- API server --------------------------------------------------------
# Comma-separated CORS allowlist. Default = localhost dev origins.
# Set to your production domain(s) before exposing the API publicly.
API_CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Salt for hashing IPs in search_logs. REQUIRED in production
# (set NODE_ENV=production). In development, a random per-process value is
# auto-generated if absent — but search_logs hashes will not be stable across
# restarts until you set this.
SEARCH_LOG_IP_SALT=

# --- Logging -----------------------------------------------------------
LOG_LEVEL=info
